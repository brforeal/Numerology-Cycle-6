+// Phase clock and task checklist helpers consumed by App.jsx.
+
+export const phaseClock = (hour) => {
+  if (hour < 6) return 'Pre-Dawn Reset';
+  if (hour < 12) return 'Morning Presence';
+  if (hour < 17) return 'Midday Action';
+  if (hour < 21) return 'Evening Reflection';
+  return 'Night Rest';
+};
+
+// Builds a checklist for the given date/numerology from a flat list of task
+// strings. markComplete mutates the shared status array in place so the
+// caller's existing reference (and any spread of it) reflects the update.
+export const taskChecklist = (dateStr, numerology, taskList) => {
+  const status = taskList.map((task) => ({ task, complete: false }));
+
+  return {
+    status,
+    markComplete: (index) => {
+      if (status[index]) {
+        status[index].complete = true;
+      }
+    },
+  };
+};
